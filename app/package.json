{
  "name": "@ramify/web-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web runtime bundled with the Ramify DeepSeek Harness plugin.",
  "license": "MIT",
  "homepage": "https://github.com/yanglongyun/dsh-ramify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanglongyun/dsh-ramify.git"
  },
  "bugs": {
    "url": "https://github.com/yanglongyun/dsh-ramify/issues"
  },
  "keywords": ["agent", "canvas", "codex", "creative", "skill"],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,ui -c yellow,cyan \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/server/**/*.test.ts src/ui/lib/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:dist": "npm run check && git diff --exit-code -- dist"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
